            "type": "string",
            "title": "Server Version"
          },
          "ffmpeg_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ffmpeg Version"
          },
          "encoder": {
            "type": "string",
            "title": "Encoder"
          },
          "capacity": {
            "type": "integer",
            "title": "Capacity"
          },
          "running": {
            "type": "integer",
            "title": "Running"
          },
          "queued": {
            "type": "integer",
            "title": "Queued"
          },
          "max_queue": {
            "type": "integer",
            "title": "Max Queue"
          },
          "disk_free_bytes": {
            "type": "integer",
            "title": "Disk Free Bytes"
          },
          "media_roots": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Media Roots"
          }
        },
        "type": "object",
        "required": [
          "api_version",
          "server_version",
          "ffmpeg_version",
          "encoder",
          "capacity",
          "running",
          "queued",
          "max_queue",
          "disk_free_bytes",
          "media_roots"
        ],
        "title": "InfoResponse"
      },
      "PathCheckRequest": {
        "properties": {
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Paths"
          }
        },
        "type": "object",
        "required": [
          "paths"
        ],
        "title": "PathCheckRequest"
      },
      "PathCheckResult": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "exists": {
            "type": "boolean",
            "title": "Exists"
          },
          "readable": {
            "type": "boolean",
            "title": "Readable"
          }
        },
        "type": "object",
        "required": [
          "path",
          "allowed",
          "exists",
          "readable"
        ],
        "title": "PathCheckResult"
      },
      "PreviewSpec": {
        "properties": {
          "segments": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Segments",
            "default": 12
          },
          "segment_duration": {
            "type": "number",
            "maximum": 30.0,
            "minimum": 0.1,
            "title": "Segment Duration",
            "default": 0.75
          },
          "exclude_start": {
            "type": "string",
            "title": "Exclude Start",
            "default": "0"
          },
          "exclude_end": {
            "type": "string",
            "title": "Exclude End",
            "default": "0"
          },
          "preset": {
            "type": "string",
            "title": "Preset",
            "default": "slow"
          },
          "audio": {
            "type": "boolean",
            "title": "Audio",
            "default": false
          },
          "crf": {
            "type": "integer",
            "maximum": 51.0,
            "minimum": 0.0,
            "title": "Crf",
            "default": 21
          },
          "width": {
            "type": "integer",
            "maximum": 7680.0,
            "minimum": 16.0,
            "title": "Width",
            "default": 640
          },
          "scale_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scale Filter"
          }
        },
        "type": "object",
        "title": "PreviewSpec"
      },
      "SpriteSpec": {
        "properties": {
          "max_frames": {
            "type": "integer",
            "maximum": 400.0,
            "minimum": 1.0,
            "title": "Max Frames",
            "default": 81
          },
          "frame_width": {
            "type": "integer",
            "maximum": 1920.0,
            "minimum": 16.0,
            "title": "Frame Width",
            "default": 160
          },
          "pre_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pre Filter"
          },
          "sprite_filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[^/\\\\]+$",
            "title": "Sprite Filename"
          }
        },
        "type": "object",
        "required": [
          "sprite_filename"
        ],
        "title": "SpriteSpec"
      },
      "TaskRequest": {
        "properties": {
          "client_task_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "title": "Client Task Id"
          },
          "video_id": {
            "type": "integer",
            "title": "Video Id"
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "title": "Source Path"
          },
          "duration": {
            "type": "number",
            "title": "Duration",
            "default": 0
          },
          "cover": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CoverSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "preview": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PreviewSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "sprite": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpriteSpec"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "client_task_id",
          "video_id",
          "source_path"
        ],
        "title": "TaskRequest"
      },
      "TaskStatus": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "client_task_id": {
            "type": "string",
            "title": "Client Task Id"
          },
          "video_id": {
            "type": "integer",
            "title": "Video Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "partial",
              "failed",
              "cancelled"
